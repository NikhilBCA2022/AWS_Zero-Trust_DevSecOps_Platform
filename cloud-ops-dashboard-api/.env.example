# Copy to .env for LOCAL development only. Never commit .env.
# These are placeholders, not real credentials.

APP_ENV=dev
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Database: use the separate parts (preferred)...
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudops
DB_USER=cloudops
DB_PASSWORD=change-me-local-only
# ...or one full URL instead (DATABASE_URL wins if both are set):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# API key(s) for write endpoints. Minimum 24 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Several keys can be comma-separated, which allows rotation without downtime.
API_KEYS=
